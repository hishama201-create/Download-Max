{
  "expo": {
    "name": "Download Max",
    "slug": "download-max",
    "version": "1.9.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "download-max",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            },
            {
              "mimeType": "text/*"
            },
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "audio/*"
            }
          ]
        }
      ],
      "package": "com.anonymous.downloadmax"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "يحتاج التطبيق إذن حفظ الوسائط لعرض ملفاتك في الاستوديو والمعرض.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
